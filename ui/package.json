{
  "name": "fivefly-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:preview": "vite build --mode preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:release": "node scripts/check-release.mjs dist",
    "check": "npm run typecheck && npm run test && npm run build && npm run check:release && npm run build:preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.10",
    "vitest": "^4.0.0"
  }
}
